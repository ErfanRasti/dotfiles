hyprglass: give each glassed window/layer/subsurface its own blur scratch framebuffer.
Upstream blurs every surface through one shared temporary framebuffer and reallocates it
whenever the next surface has a different size, which with windows + bar + panels meant
~40 GPU framebuffer allocations per second (seen in hyprland.log). blurBackground() already
takes a per-caller buffer; this passes one. Costs one extra sample-sized buffer per glass.

diff --git a/src/GlassDecoration.cpp b/src/GlassDecoration.cpp
index 94759b8..5ae29d6 100644
--- a/src/GlassDecoration.cpp
+++ b/src/GlassDecoration.cpp
@@ -594,7 +594,7 @@ void CGlassDecoration::renderPass(Render::CRenderContext& ctx, PHLMONITOR monito
                 blurIterations = folded.iterations;
             }
 
-            GlassRenderer::blurBackground(ctx, m_sampleFramebuffer, blurRadius, blurIterations, source);
+            GlassRenderer::blurBackground(ctx, m_sampleFramebuffer, blurRadius, blurIterations, source, &m_blurTempFramebuffer);
 
             m_frost.sampleChanged();
 
diff --git a/src/GlassDecoration.hpp b/src/GlassDecoration.hpp
index c03c1b7..5b691b6 100644
--- a/src/GlassDecoration.hpp
+++ b/src/GlassDecoration.hpp
@@ -75,6 +75,9 @@ class CGlassDecoration : public IHyprWindowDecoration {
   private:
     PHLWINDOWREF m_window;
     SP<Render::IFramebuffer> m_sampleFramebuffer;
+    // Own blur scratch buffer: the shared global one is reallocated every time glass of a
+    // different size is blurred (windows, bar, panels...), i.e. many times per second.
+    SP<Render::IFramebuffer> m_blurTempFramebuffer;
     GlassRenderer::SSampleMap m_sampleMap;
 
     // Last geometry seen in updateWindow(), to detect real moves/resizes
