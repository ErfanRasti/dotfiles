// Generated by matugen into ~/.config/umbriel/config/spotify_wave.glsl; edit the template
// (~/.config/matugen/templates/umbriel-spotify-wave.glsl), not the output.
// Audio-reactive 64-band standing-wave line on the left/right window edges, based on
// https://gist.github.com/acous/0e3ae193232cdaffbdeb1ea34c652e50 (by acous).

const float BASELINE_PX  = 1.0;   // resting line, flush against the border
const float MAX_PX       = 11.0;  // never further out than this (fits the effect padding)
const float AMPLITUDE_PX = 2.8;   // how far the waves push outward
const float V_SHIFT      = 0.10;  // wave band centre, as a fraction above the middle
const float V_SPAN       = 0.85;  // wave band half-height, as a fraction of the window
const float V_FLAT       = 0.60;  // inner part of the band (fraction of V_SPAN) at full strength

// Theme colours as 0xRRGGBB (exact in a float). Not umbriel's effect palette, which ends in red.
const float HEX_PRIMARY   = float(0x{{colors.primary.default.hex_stripped}});
const float HEX_SECONDARY = float(0x{{colors.secondary.default.hex_stripped}});
const float HEX_TERTIARY  = float(0x{{colors.tertiary.default.hex_stripped}});

vec3 hex_rgb(float h) {
  return vec3(floor(h / 65536.0), mod(floor(h / 256.0), 256.0), mod(h, 256.0)) / 255.0;
}

vec4 border(vec2 uv) {
  float d = max(umbriel_border_distance(uv), 0.0);
  vec4 native = umbriel_sample(uv);
  // Keep a window shadow when the native border area comes in empty.
  if (native.a <= 0.01) {
    float ds = max(umbriel_border_distance(uv - vec2(0.0, 3.0) / umbriel_size), 0.0);
    float s = clamp(1.0 - ds / 6.0, 0.0, 1.0);
    native = vec4(0.0, 0.0, 0.0, 0.44 * s * s);
  }

  // Window half-extents and centre-relative position, in logical px
  vec2 win_half = max(umbriel_border_hole.zw * umbriel_size * 0.5, vec2(1.0));
  vec2 p = (uv - (umbriel_border_hole.xy + umbriel_border_hole.zw * 0.5)) * umbriel_size;

  // Side edges only, along a flat-topped band shifted up from the middle so the waves stay
  // clear of the bar (top) and the dock (bottom).
  float vy = (clamp(p.y / win_half.y, -1.0, 1.0) + V_SHIFT) / V_SPAN;
  float envelope = smoothstep(win_half.x - 4.0, win_half.x, abs(p.x))
                 * (1.0 - smoothstep(V_FLAT, 1.0, abs(vy)));

  float trace_d = BASELINE_PX;
  float slope = 0.0;
  float loudness = 0.0;
  float high_mod = 0.0;

  if (envelope > 1e-3 && umbriel_audio_available() > 0.5) {
    float wave_sum = 0.0, slope_sum = 0.0, energy_sum = 0.0, high_sum = 0.0, peak = 0.0;
    float k = 0.024;  // spatial frequency: 0.024 * exp(i/63 * 4.828), stepped by K_STEP

    for (int i = 0; i < 64; i++) {
      float fi = float(i);
      float n = fi / 63.0;
      float root_n = sqrt(n);

      float x = clamp((umbriel_audio_entry(fi) * (2.0 + 0.8 * n * n) - 0.035) * 1.25, 0.0, 1.5);
      float a = x * x * sqrt(sqrt(sqrt(x))) * (1.15 - 0.70 * root_n);  // x^2.125, tilted

      float s_pos = k * p.y + fi * 2.3999632;
      float c_time = cos((8.0 + 57.0 * n * root_n) * umbriel_time + fi * 1.6180339);

      wave_sum   += a * sin(s_pos) * c_time;
      slope_sum  += a * k * cos(s_pos) * c_time;
      energy_sum += a * a;
      high_sum   += a * n;
      peak        = max(peak, a);

      k *= 1.0796488;  // K_STEP = exp(4.828 / 63)
    }

    float rms_env = envelope * inversesqrt(max(energy_sum * 0.4225, 1.0));
    trace_d = clamp(BASELINE_PX + abs(wave_sum * rms_env) * AMPLITUDE_PX, BASELINE_PX, MAX_PX);
    slope = slope_sum * rms_env * 1.25;
    loudness = clamp(max(peak, sqrt(energy_sum) * 0.42), 0.0, 1.35) * envelope;
    high_mod = high_sum * 0.06 * envelope;
  }

  float line_dist = abs(d - trace_d);
  float trace = smoothstep(1.75, 0.30, line_dist * clamp(inversesqrt(1.0 + slope * slope), 0.2857, 1.0));
  float glow  = exp(-line_dist / (2.0 + 2.0 * loudness)) * (0.10 + 0.50 * min(loudness, 1.0));

  // Primary (= the focused border) when quiet, through secondary to tertiary when loud/bright.
  float pos = clamp((loudness * 0.35 + high_mod) * 3.0, 0.0, 2.0);
  vec3 base = mix(mix(hex_rgb(HEX_PRIMARY), hex_rgb(HEX_SECONDARY), min(pos, 1.0)),
                  hex_rgb(HEX_TERTIARY), max(pos - 1.0, 0.0));

  vec3 beam = mix(base, vec3(1.0), trace * (0.25 + 0.50 * min(loudness, 1.0)));
  return mix(native, vec4(beam, 1.0), min(trace + glow, 1.0));  // beam over native
}
