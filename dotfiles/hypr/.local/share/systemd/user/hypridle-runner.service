# ~/.local/share/systemd/user/hypridle-runner.service
[Unit]
Description=Hyprland's idle runner daemon
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# %h = home; the script's shebang finds bash via the manager PATH (no bare `sh` on NixOS)
ExecStart=%h/.config/hypr/scripts/hypridle_runner.sh
Restart=on-failure

[Install]
WantedBy=graphical-session.target

